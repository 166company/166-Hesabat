# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars_please_change_this
JWT_EXPIRES_IN=7d

# Encryption (32-byte hex string: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here_please_change

# Admin Email
ADMIN_EMAIL=cavidanbusiness2026@gmail.com
ADMIN_NAME=Admin

# Gmail SMTP (use App Password, not main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cavidanbusiness2026@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Meta Ads (Optional - App credentials for token validation)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Google Ads API
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_MANAGER_CUSTOMER_ID=your_manager_customer_id_optional

# Database
DB_PATH=./data/ads_audit.db
